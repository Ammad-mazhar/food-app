# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way — it holds live credentials.
# This file holds names only, never values.

# ---------------------------------------------------------------- database
#
# Both come from Supabase: Project Settings > Database > Connection string.
# They are NOT interchangeable.
#
# DATABASE_URL — the pooled connection (port 6543, "Transaction" mode).
#   Used by the running app. Must end with ?pgbouncer=true because Prisma
#   cannot use prepared statements through a transaction pooler.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# DIRECT_DATABASE_URL — the direct connection (port 5432, "Session" mode).
#   Used only by `prisma migrate`, which needs advisory locks and DDL that a
#   pooler drops. Leave blank for a plain local Postgres.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL=

# ------------------------------------------------------------------ server
#
# SESSION_SECRET — a random string YOU generate. This does not come from
#   Supabase or any other service; nothing external ever needs to know it.
#   It is the HMAC key used to hash session tokens before they are stored
#   (see src/lib/session.ts), so a leaked session table is not a list of
#   working logins.
#
#   Generate one (works anywhere Node is installed):
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
#   Or in Windows PowerShell 5.1 without Node. Do NOT substitute Get-Random
#   (not a CSPRNG) or RandomNumberGenerator::Fill (.NET Core only — on 5.1 it
#   throws and leaves the buffer as 32 zero bytes, which still base64-encodes
#   to a convincing-looking string):
#     $rng = New-Object System.Security.Cryptography.RNGCryptoServiceProvider
#     $b = New-Object byte[] 32
#     $rng.GetBytes($b)
#     [Convert]::ToBase64String($b)
#
#   Changing it logs everybody out. Use a different value per environment.
SESSION_SECRET=

# ---------------------------------------------------------------- optional
#
# Absolute base URL, no trailing slash. Used by metadata, the sitemap and
# robots.txt. Defaults to a placeholder domain if unset.
NEXT_PUBLIC_SITE_URL=

# Email address that staff order notifications go to. Leave blank to disable
# notifications — the app will log them instead of sending.
STAFF_NOTIFICATION_EMAIL=
