# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template holds variable names only, no values, and is meant to be
# committed so a fresh checkout knows what to fill in.
!.env.example

# Prisma's generated client — rebuilt by `prisma generate`, never edited.
/generated

# vercel
.vercel

# netlify — local build output and, critically, the Turbopack persistent cache.
# That cache records the env vars a build read (so it knows when to invalidate),
# which means SESSION_SECRET and the database URLs end up inside it verbatim.
# Committing it would publish them.
.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts
